# ============================================
# 复制本文件为 .env 后按需修改：
#   cp .env.example .env
# ============================================

# Database (与 docker-compose.yml 中的配置保持一致)
DB_HOST="localhost"
DB_PORT="5432"
DB_USERNAME="laser_user"
DB_PASSWORD="laser_pass_2024"
DB_DATABASE="laser_maintenance"

# JWT
# 生产环境务必替换为随机长字符串，例如：openssl rand -hex 32
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Redis
REDIS_HOST="localhost"
REDIS_PORT="6379"

# App
PORT="8080"
# development 下 TypeORM 会自动同步表结构(synchronize=true)
NODE_ENV="development"

# 阿里云百炼 API (AI客服 / AI助手)
# 留空则 AI 相关接口不可用，其余功能正常
# 申请地址: https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=""

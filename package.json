{
  "name": "laser-maintenance-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=backend",
    "dev:customer": "npm run dev --workspace=apps/customer-app",
    "dev:engineer": "npm run dev --workspace=apps/engineer-app",
    "dev:cs-admin": "npm run dev --workspace=apps/cs-admin",
    "build:all": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test:product": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/test-product.ps1",
    "preview:local": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/start-preview.ps1"
  }
}

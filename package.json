{
  "name": "laser-maintenance-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=backend",
    "dev:customer": "npm run dev --workspace=apps/customer-app",
    "dev:engineer": "npm run dev --workspace=apps/engineer-app",
    "dev:cs-admin": "npm run dev --workspace=apps/cs-admin",
    "build:all": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  }
}
